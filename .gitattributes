* text=auto

# 源代码统一 LF，避免跨平台混用
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.iss   text eol=crlf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.vbs   text eol=crlf

# 二进制资源不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pickle binary
*.rep  binary
*.dict binary
