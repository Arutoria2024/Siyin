# GSV.CPP tuned launch config (ASCII, no BOM)
# Backend: vulkan (GPU) or cpu
GSV_DEVICE=vulkan
GSV_PORT=9880
GSV_SIDECAR_PORT=9882
# threads: leave empty -> engine picks physical cores (8 here)
GSV_THREADS=
# set 1 to auto-open the GAG GUI
GSV_OPEN_GUI=0
# default voice to load after startup (empty = default model)
GSV_VOICE=si
